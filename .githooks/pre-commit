#!/bin/sh
# Blocks commits that contain secrets.
# Enable once per clone: git config core.hooksPath .githooks
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, refusing to commit without a secret scan." >&2
  echo "Install it from https://github.com/gitleaks/gitleaks and try again." >&2
  exit 1
fi

gitleaks git --staged --redact --no-banner
